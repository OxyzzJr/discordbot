# Configuration partagée par les deux implémentations (Python et Rust).
# Copie ce fichier vers .env puis renseigne au minimum DISCORD_TOKEN.

# ── Obligatoire ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=token-sur-le-portail-developpeur-discord

# ── Commande owner secrète (!ascend) ──────────────────────────────────────────
# Laissé à 0, la commande est inerte pour tout le monde.
OWNER_ID=0

# ── Modération ────────────────────────────────────────────────────────────────
MAX_WARNINGS=3
MUTE_ROLE_NAME=Muted
LOG_CHANNEL_NAME=mod-logs

# ── Auto-modération ───────────────────────────────────────────────────────────
# Valeurs de repli : la configuration stockée par serveur (table automod_config)
# a la priorité quand elle existe.
SPAM_THRESHOLD=5
SPAM_INTERVAL=10
MAX_MENTIONS=5

# ── Stockage ──────────────────────────────────────────────────────────────────
# Sous Docker, les deux compose forcent /data/moderation.db.
DATABASE_PATH=moderation.db

# ── Serveur keep-alive ────────────────────────────────────────────────────────
# Version Rust uniquement. La version Python écoute toujours sur 5000.
KEEPALIVE_PORT=5000

# ── Logs (version Rust) ───────────────────────────────────────────────────────
RUST_LOG=info,serenity=warn
