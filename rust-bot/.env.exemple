# ── Obligatoire ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=token-sur-le-portail-developpeur-discord

# ── Commande owner secrète (!ascend) ──────────────────────────────────────────
# Sans OWNER_ID, la commande est inerte pour tout le monde.
OWNER_ID=0

# ── Modération ────────────────────────────────────────────────────────────────
MAX_WARNINGS=3
MUTE_ROLE_NAME=Muted
LOG_CHANNEL_NAME=mod-logs

# ── Auto-modération (valeurs de repli ; la config par serveur prime) ──────────
SPAM_THRESHOLD=5
SPAM_INTERVAL=10
MAX_MENTIONS=5

# ── Stockage ──────────────────────────────────────────────────────────────────
DATABASE_PATH=moderation.db

# ── Serveur keep-alive ────────────────────────────────────────────────────────
# 5000 par défaut, comme la version Python. À changer uniquement pour faire
# cohabiter les deux bots sur la même machine.
KEEPALIVE_PORT=5000

# ── Logs ──────────────────────────────────────────────────────────────────────
RUST_LOG=info,serenity=warn
